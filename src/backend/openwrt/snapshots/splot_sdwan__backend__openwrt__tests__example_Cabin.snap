---
source: src/backend/openwrt/mod.rs
expression: output
---
# network
set network.spl_mesh='interface'
set network.spl_mesh.proto='wireguard'
set network.spl_mesh.private_key='FAKE_MESH_KEY'
set network.spl_mesh.listen_port='51820'
add_list network.spl_mesh.addresses='10.100.0.2/16'
set network.spl_wireguard_spl_mesh_Home='wireguard_spl_mesh'
set network.spl_wireguard_spl_mesh_Home.description='[SPLOT] Home'
set network.spl_wireguard_spl_mesh_Home.public_key='ReplaceHomePublicKeyAAAAAAAAAAAAAAAAAAAAAAA='
set network.spl_wireguard_spl_mesh_Home.route_allowed_ips='1'
set network.spl_wireguard_spl_mesh_Home.persistent_keepalive='25'
set network.spl_wireguard_spl_mesh_Home.endpoint_host='203.0.113.10'
set network.spl_wireguard_spl_mesh_Home.endpoint_port='51820'
add_list network.spl_wireguard_spl_mesh_Home.allowed_ips='10.100.0.1/32'
add_list network.spl_wireguard_spl_mesh_Home.allowed_ips='10.100.10.0/24'
add_list network.spl_wireguard_spl_mesh_Home.allowed_ips='192.168.1.0/24'
set network.spl_wireguard_spl_mesh_Phone='wireguard_spl_mesh'
set network.spl_wireguard_spl_mesh_Phone.description='[SPLOT] Phone'
set network.spl_wireguard_spl_mesh_Phone.public_key='ReplacePhonePublicKeyAAAAAAAAAAAAAAAAAAAAAA='
set network.spl_wireguard_spl_mesh_Phone.route_allowed_ips='0'
set network.spl_wireguard_spl_mesh_Phone.persistent_keepalive='25'
add_list network.spl_wireguard_spl_mesh_Phone.allowed_ips='10.100.0.100/32'
# firewall
set firewall.spl_zone_mesh='zone'
set firewall.spl_zone_mesh.name='[SPLOT] mesh'
set firewall.spl_zone_mesh.input='DROP'
set firewall.spl_zone_mesh.output='ACCEPT'
set firewall.spl_zone_mesh.forward='DROP'
add_list firewall.spl_zone_mesh.network='spl_mesh'
set firewall.spl_rule_in_camera_rtsp='rule'
set firewall.spl_rule_in_camera_rtsp.name='[SPLOT] camera_rtsp'
set firewall.spl_rule_in_camera_rtsp.src='*'
set firewall.spl_rule_in_camera_rtsp.dest='*'
set firewall.spl_rule_in_camera_rtsp.dest_port='554'
set firewall.spl_rule_in_camera_rtsp.target='ACCEPT'
add_list firewall.spl_rule_in_camera_rtsp.dest_ip='192.168.2.30/32'
add_list firewall.spl_rule_in_camera_rtsp.src_ip='10.100.0.100/32'
add_list firewall.spl_rule_in_camera_rtsp.src_ip='192.168.1.50/32'
add_list firewall.spl_rule_in_camera_rtsp.proto='tcp'
# dhcp
set dhcp.spl_host_camera='host'
set dhcp.spl_host_camera.name='[SPLOT] camera'
set dhcp.spl_host_camera.ip='192.168.2.30'
add_list dhcp.spl_host_camera.mac='aa:bb:cc:00:00:04'
