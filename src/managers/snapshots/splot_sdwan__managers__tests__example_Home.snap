---
source: src/managers/mod.rs
expression: output
---
# network
set network.spl_mesh='interface'
set network.spl_mesh.proto='wireguard'
set network.spl_mesh.private_key='FAKE_MESH_KEY'
set network.spl_mesh.listen_port='51820'
add_list network.spl_mesh.address='10.100.0.1/24'
set network.spl_Cabin='wireguard_spl_mesh'
set network.spl_Cabin.description='[SPLOT] Cabin'
set network.spl_Cabin.public_key='ReplaceCabinPublicKeyAAAAAAAAAAAAAAAAAAAAAA='
set network.spl_Cabin.route_allowed_ips='1'
set network.spl_Cabin.persistent_keepalive='25'
set network.spl_Cabin.endpoint_host='203.0.113.20'
set network.spl_Cabin.endpoint_port='51820'
add_list network.spl_Cabin.allowed_ips='10.100.0.2/32'
add_list network.spl_Cabin.allowed_ips='192.168.2.0/24'
set network.spl_Phone='wireguard_spl_mesh'
set network.spl_Phone.description='[SPLOT] Phone'
set network.spl_Phone.public_key='ReplacePhonePublicKeyAAAAAAAAAAAAAAAAAAAAAA='
set network.spl_Phone.route_allowed_ips='0'
set network.spl_Phone.persistent_keepalive='25'
add_list network.spl_Phone.allowed_ips='10.100.0.100/32'
set network.spl_guests='interface'
set network.spl_guests.proto='wireguard'
set network.spl_guests.private_key='FAKE_VPN_KEY_guests'
set network.spl_guests.listen_port='51821'
add_list network.spl_guests.address='10.8.0.1/24'
set network.spl_laptop='wireguard_spl_guests'
set network.spl_laptop.description='[SPLOT] laptop'
set network.spl_laptop.public_key='ReplaceLaptopPublicKeyAAAAAAAAAAAAAAAAAAAAA='
set network.spl_laptop.route_allowed_ips='0'
set network.spl_laptop.persistent_keepalive='25'
add_list network.spl_laptop.allowed_ips='10.8.0.2/32'
# firewall
set firewall.spl_mesh='zone'
set firewall.spl_mesh.name='[SPLOT] mesh'
set firewall.spl_mesh.input='DROP'
set firewall.spl_mesh.output='ACCEPT'
set firewall.spl_mesh.forward='DROP'
add_list firewall.spl_mesh.network='spl_mesh'
set firewall.spl_guests='zone'
set firewall.spl_guests.name='[SPLOT] guests'
set firewall.spl_guests.input='DROP'
set firewall.spl_guests.output='ACCEPT'
set firewall.spl_guests.forward='DROP'
add_list firewall.spl_guests.network='spl_guests'
set firewall.spl_Home_ssh='rule'
set firewall.spl_Home_ssh.name='[SPLOT] Home_ssh'
set firewall.spl_Home_ssh.src='*'
set firewall.spl_Home_ssh.dest='*'
set firewall.spl_Home_ssh.dest_port='22'
set firewall.spl_Home_ssh.target='ACCEPT'
add_list firewall.spl_Home_ssh.dest_ip='10.100.0.1/32'
add_list firewall.spl_Home_ssh.dest_ip='10.8.0.1/32'
add_list firewall.spl_Home_ssh.dest_ip='192.168.1.1/32'
add_list firewall.spl_Home_ssh.src_ip='10.100.0.100/32'
add_list firewall.spl_Home_ssh.src_ip='10.8.0.2/32'
add_list firewall.spl_Home_ssh.src_ip='192.168.1.50/32'
add_list firewall.spl_Home_ssh.proto='tcp'
set firewall.spl_nas_https='rule'
set firewall.spl_nas_https.name='[SPLOT] nas_https'
set firewall.spl_nas_https.src='*'
set firewall.spl_nas_https.dest='*'
set firewall.spl_nas_https.dest_port='443'
set firewall.spl_nas_https.target='ACCEPT'
add_list firewall.spl_nas_https.dest_ip='192.168.1.20/32'
add_list firewall.spl_nas_https.src_ip='10.100.0.100/32'
add_list firewall.spl_nas_https.src_ip='10.8.0.2/32'
add_list firewall.spl_nas_https.proto='tcp'
set firewall.spl_printer_print='rule'
set firewall.spl_printer_print.name='[SPLOT] printer_print'
set firewall.spl_printer_print.src='*'
set firewall.spl_printer_print.dest='*'
set firewall.spl_printer_print.dest_port='9100'
set firewall.spl_printer_print.target='ACCEPT'
add_list firewall.spl_printer_print.dest_ip='192.168.1.16/32'
add_list firewall.spl_printer_print.src_ip='10.100.0.100/32'
add_list firewall.spl_printer_print.src_ip='10.8.0.2/32'
add_list firewall.spl_printer_print.proto='tcp'
set firewall.spl_Cabin_camera_rtsp='rule'
set firewall.spl_Cabin_camera_rtsp.name='[SPLOT] Cabin_camera_rtsp'
set firewall.spl_Cabin_camera_rtsp.src='*'
set firewall.spl_Cabin_camera_rtsp.dest='*'
set firewall.spl_Cabin_camera_rtsp.dest_port='554'
set firewall.spl_Cabin_camera_rtsp.target='ACCEPT'
add_list firewall.spl_Cabin_camera_rtsp.dest_ip='192.168.2.30/32'
add_list firewall.spl_Cabin_camera_rtsp.src_ip='10.8.0.2/32'
add_list firewall.spl_Cabin_camera_rtsp.src_ip='192.168.1.50/32'
add_list firewall.spl_Cabin_camera_rtsp.proto='tcp'
set firewall.spl_Home_nas_https_redirect='redirect'
set firewall.spl_Home_nas_https_redirect.name='[SPLOT] Home_nas_https_redirect'
set firewall.spl_Home_nas_https_redirect.target='DNAT'
set firewall.spl_Home_nas_https_redirect.src='wan'
set firewall.spl_Home_nas_https_redirect.src_dport='8443'
add_list firewall.spl_Home_nas_https_redirect.src_ip='198.51.100.0/24'
set firewall.spl_Home_nas_https_redirect.dest='lan'
set firewall.spl_Home_nas_https_redirect.dest_ip='192.168.1.20'
set firewall.spl_Home_nas_https_redirect.dest_port='443'
add_list firewall.spl_Home_nas_https_redirect.proto='tcp'
# dhcp
set dhcp.spl_nas='host'
set dhcp.spl_nas.name='[SPLOT] nas'
set dhcp.spl_nas.ip='192.168.1.20'
add_list dhcp.spl_nas.mac='aa:bb:cc:00:00:03'
set dhcp.spl_printer='host'
set dhcp.spl_printer.name='[SPLOT] printer'
set dhcp.spl_printer.ip='192.168.1.16'
add_list dhcp.spl_printer.mac='aa:bb:cc:00:00:02'
set dhcp.spl_Phone='host'
set dhcp.spl_Phone.name='[SPLOT] Phone'
set dhcp.spl_Phone.ip='192.168.1.50'
add_list dhcp.spl_Phone.mac='aa:bb:cc:00:00:01'
