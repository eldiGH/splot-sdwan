---
source: src/managers/mod.rs
expression: output
---
# network
set network.spl_mesh='interface'
set network.spl_mesh.proto='wireguard'
set network.spl_mesh.private_key='FAKE_MESH_KEY'
set network.spl_mesh.listen_port='51820'
add_list network.spl_mesh.address='10.100.0.2/24'
set network.spl_Home='wireguard_spl_mesh'
set network.spl_Home.description='[SPLOT] Home'
set network.spl_Home.public_key='REPLACE_WITH_HOME_WG_PUBLIC_KEY'
set network.spl_Home.route_allowed_ips='1'
set network.spl_Home.persistent_keepalive='25'
set network.spl_Home.endpoint_host='203.0.113.10'
set network.spl_Home.endpoint_port='51820'
add_list network.spl_Home.allowed_ips='10.100.0.1/32'
add_list network.spl_Home.allowed_ips='10.8.0.0/24'
add_list network.spl_Home.allowed_ips='192.168.1.0/24'
set network.spl_Phone='wireguard_spl_mesh'
set network.spl_Phone.description='[SPLOT] Phone'
set network.spl_Phone.public_key='REPLACE_WITH_PHONE_WG_PUBLIC_KEY'
set network.spl_Phone.route_allowed_ips='0'
set network.spl_Phone.persistent_keepalive='25'
add_list network.spl_Phone.allowed_ips='10.100.0.100/32'
# firewall
set firewall.spl_mesh='zone'
set firewall.spl_mesh.name='[SPLOT] mesh'
set firewall.spl_mesh.input='DROP'
set firewall.spl_mesh.output='ACCEPT'
set firewall.spl_mesh.forward='DROP'
add_list firewall.spl_mesh.network='spl_mesh'
set firewall.spl_camera_rtsp='rule'
set firewall.spl_camera_rtsp.name='[SPLOT] camera_rtsp'
set firewall.spl_camera_rtsp.src='*'
set firewall.spl_camera_rtsp.dest='*'
set firewall.spl_camera_rtsp.dest_port='554'
set firewall.spl_camera_rtsp.target='ACCEPT'
add_list firewall.spl_camera_rtsp.dest_ip='192.168.2.30/32'
add_list firewall.spl_camera_rtsp.src_ip='10.100.0.100/32'
add_list firewall.spl_camera_rtsp.src_ip='10.8.0.2/32'
add_list firewall.spl_camera_rtsp.src_ip='192.168.1.50/32'
add_list firewall.spl_camera_rtsp.proto='tcp'
# dhcp
set dhcp.spl_camera='host'
set dhcp.spl_camera.name='[SPLOT] camera'
set dhcp.spl_camera.ip='192.168.2.30'
add_list dhcp.spl_camera.mac='aa:bb:cc:00:00:04'
