# dnsmasq sections: splot's values
server /home.example.org/
server /barn.example.org/192.168.4.2
server /cabin.example.org/192.168.2.1
server /wg.cabin.example.org/#
rebind_domain barn.example.org
rebind_domain cabin.example.org
of domains home.example.org, barn.example.org, cabin.example.org
# owned
from spl_mesh to any zone
from iot to spl_mesh
from iot to lan
from lan to spl_mesh
from lan to iot
from spl_mesh to the node
