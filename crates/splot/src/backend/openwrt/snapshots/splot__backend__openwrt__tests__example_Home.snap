---
source: crates/splot/src/backend/openwrt/mod.rs
expression: output
---
# network: splot's interface, wireguard_spl_mesh
set network.spl_mesh='interface'
set network.spl_mesh.proto='wireguard'
set network.spl_mesh.private_key='<private key>'
set network.spl_mesh.listen_port='51820'
add_list network.spl_mesh.addresses='10.100.0.1/16'
set network.spl_wireguard_spl_mesh_Barn='wireguard_spl_mesh'
set network.spl_wireguard_spl_mesh_Barn.description='[SPLOT] Barn'
set network.spl_wireguard_spl_mesh_Barn.public_key='ReplaceBarnPublicKeyAAAAAAAAAAAAAAAAAAAAAAA='
set network.spl_wireguard_spl_mesh_Barn.preshared_key='<preshared key>'
set network.spl_wireguard_spl_mesh_Barn.route_allowed_ips='1'
set network.spl_wireguard_spl_mesh_Barn.endpoint_host='203.0.113.30'
set network.spl_wireguard_spl_mesh_Barn.endpoint_port='51820'
add_list network.spl_wireguard_spl_mesh_Barn.allowed_ips='10.100.0.4/32'
add_list network.spl_wireguard_spl_mesh_Barn.allowed_ips='192.168.4.0/24'
add_list network.spl_wireguard_spl_mesh_Barn.allowed_ips='192.168.40.0/24'
set network.spl_wireguard_spl_mesh_Cabin='wireguard_spl_mesh'
set network.spl_wireguard_spl_mesh_Cabin.description='[SPLOT] Cabin'
set network.spl_wireguard_spl_mesh_Cabin.public_key='ReplaceCabinPublicKeyAAAAAAAAAAAAAAAAAAAAAA='
set network.spl_wireguard_spl_mesh_Cabin.preshared_key='<preshared key>'
set network.spl_wireguard_spl_mesh_Cabin.route_allowed_ips='1'
set network.spl_wireguard_spl_mesh_Cabin.endpoint_host='wg.cabin.example.org'
set network.spl_wireguard_spl_mesh_Cabin.endpoint_port='51820'
add_list network.spl_wireguard_spl_mesh_Cabin.allowed_ips='10.100.0.2/32'
add_list network.spl_wireguard_spl_mesh_Cabin.allowed_ips='192.168.2.0/24'
set network.spl_wireguard_spl_mesh_Lake='wireguard_spl_mesh'
set network.spl_wireguard_spl_mesh_Lake.description='[SPLOT] Lake'
set network.spl_wireguard_spl_mesh_Lake.public_key='ReplaceLakePublicKeyAAAAAAAAAAAAAAAAAAAAAAA='
set network.spl_wireguard_spl_mesh_Lake.preshared_key='<preshared key>'
set network.spl_wireguard_spl_mesh_Lake.route_allowed_ips='1'
add_list network.spl_wireguard_spl_mesh_Lake.allowed_ips='10.100.0.3/32'
add_list network.spl_wireguard_spl_mesh_Lake.allowed_ips='192.168.3.0/24'
set network.spl_wireguard_spl_mesh_Phone='wireguard_spl_mesh'
set network.spl_wireguard_spl_mesh_Phone.description='[SPLOT] Phone'
set network.spl_wireguard_spl_mesh_Phone.public_key='ReplacePhonePublicKeyAAAAAAAAAAAAAAAAAAAAAA='
set network.spl_wireguard_spl_mesh_Phone.preshared_key='<preshared key>'
set network.spl_wireguard_spl_mesh_Phone.route_allowed_ips='0'
add_list network.spl_wireguard_spl_mesh_Phone.allowed_ips='10.100.0.100/32'
set network.spl_wireguard_spl_mesh_lte_cam='wireguard_spl_mesh'
set network.spl_wireguard_spl_mesh_lte_cam.description='[SPLOT] Home.lte-cam'
set network.spl_wireguard_spl_mesh_lte_cam.public_key='ReplaceLteCamPublicKeyAAAAAAAAAAAAAAAAAAAAA='
set network.spl_wireguard_spl_mesh_lte_cam.route_allowed_ips='0'
add_list network.spl_wireguard_spl_mesh_lte_cam.allowed_ips='10.100.10.10/32'
# firewall: splot's zone, rule, redirect, nat
set firewall.spl_zone_mesh='zone'
set firewall.spl_zone_mesh.name='spl_mesh'
set firewall.spl_zone_mesh.input='DROP'
set firewall.spl_zone_mesh.output='ACCEPT'
set firewall.spl_zone_mesh.forward='DROP'
add_list firewall.spl_zone_mesh.network='spl_mesh'
set firewall.spl_rule_ping='rule'
set firewall.spl_rule_ping.name='[SPLOT] ping from its peers'
set firewall.spl_rule_ping.src='spl_mesh'
set firewall.spl_rule_ping.family='ipv4'
set firewall.spl_rule_ping.proto='icmp'
add_list firewall.spl_rule_ping.icmp_type='echo-request'
add_list firewall.spl_rule_ping.src_ip='10.100.0.100'
add_list firewall.spl_rule_ping.src_ip='10.100.0.2'
add_list firewall.spl_rule_ping.src_ip='10.100.0.3'
add_list firewall.spl_rule_ping.src_ip='10.100.0.4'
add_list firewall.spl_rule_ping.src_ip='10.100.10.10'
add_list firewall.spl_rule_ping.dest_ip='10.100.0.1'
set firewall.spl_rule_ping.target='ACCEPT'
set firewall.spl_rule_listen_port='rule'
set firewall.spl_rule_listen_port.name='[SPLOT] WireGuard listen port'
set firewall.spl_rule_listen_port.src='wan'
set firewall.spl_rule_listen_port.proto='udp'
set firewall.spl_rule_listen_port.dest_port='51820'
set firewall.spl_rule_listen_port.target='ACCEPT'
