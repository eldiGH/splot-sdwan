---
source: crates/splot/src/backend/linux/mod.rs
expression: config.masked()
---
# The mesh interface of node Barn, written by splot. `splot apply`
# replaces it: change splot.yml instead.
[Interface]
Address = 10.100.0.4/16
ListenPort = 51820
PrivateKey = <private key>

# Cabin
[Peer]
PublicKey = ReplaceCabinPublicKeyAAAAAAAAAAAAAAAAAAAAAA=
PresharedKey = <preshared key>
AllowedIPs = 10.100.0.2/32, 192.168.2.0/24
Endpoint = cabin.example.net:51820

# Home
[Peer]
PublicKey = ReplaceHomePublicKeyAAAAAAAAAAAAAAAAAAAAAAA=
PresharedKey = <preshared key>
AllowedIPs = 10.100.0.1/32, 192.168.10.0/24, 192.168.1.0/24, 10.100.10.0/24
Endpoint = 203.0.113.10:51820

# Lake
[Peer]
PublicKey = ReplaceLakePublicKeyAAAAAAAAAAAAAAAAAAAAAAA=
PresharedKey = <preshared key>
AllowedIPs = 10.100.0.3/32, 192.168.3.0/24

# Phone
[Peer]
PublicKey = ReplacePhonePublicKeyAAAAAAAAAAAAAAAAAAAAAA=
PresharedKey = <preshared key>
AllowedIPs = 10.100.0.100/32
