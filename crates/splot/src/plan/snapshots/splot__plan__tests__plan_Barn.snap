---
source: crates/splot/src/plan/mod.rs
expression: plan.to_string()
---
# Barn: key ReplaceBarnPublicKeyAAAAAAAAAAAAAAAAAAAAAAA=

[wireguard]
interface: listen 51820, address 10.100.0.4/16
peer Cabin at 10.100.0.2: key ReplaceCabinPublicKeyAAAAAAAAAAAAAAAAAAAAAA=, allowed [10.100.0.2/32, 192.168.2.0/24], routed, endpoint wg.cabin.example.org:51820, psk
peer Home at 10.100.0.1: key ReplaceHomePublicKeyAAAAAAAAAAAAAAAAAAAAAAA=, allowed [10.100.0.1/32, 192.168.10.0/24, 192.168.1.0/24, 10.100.10.0/24], routed, endpoint 203.0.113.10:51820, psk
peer Lake at 10.100.0.3: key ReplaceLakePublicKeyAAAAAAAAAAAAAAAAAAAAAAA=, allowed [10.100.0.3/32, 192.168.3.0/24], routed, psk
peer Phone at 10.100.0.100: key ReplacePhonePublicKeyAAAAAAAAAAAAAAAAAAAAAA=, allowed [10.100.0.100/32], psk

[firewall]
mesh zone: input drop, output accept, forward drop
ping 10.100.0.4 from [Cabin 10.100.0.2, Home 10.100.0.1, Lake 10.100.0.3, Phone 10.100.0.100]
listen port: wan udp/51820
accept in Barn ssh: tcp/22 from mesh [10.100.0.100/32, 192.168.1.50/32] to the node [10.100.0.4/32, 192.168.40.1/32, 192.168.4.2/32]
accept in Barn.nvr web: tcp/443 from mesh [10.100.0.100/32, 192.168.1.50/32] to lan [192.168.4.10/32]
accept out Cabin.camera rtsp: tcp/554 from lan [192.168.4.10/32] to mesh [192.168.2.30/32]
otherwise drop: between [mesh, iot, lan], and from mesh to any zone
forward Barn.nvr web: wan tcp/8443 from [198.51.100.0/24, 203.0.113.7/32] to lan 192.168.4.10:443
forward Cabin.weather http: wan tcp/8080 from [] to mesh 192.168.2.40:80 as 10.100.0.4

[dhcp]
lease Barn.nvr as nvr: 192.168.4.10 for [aa:bb:cc:00:00:07]
routes on lan: default via 192.168.4.1, [10.100.0.0/16, 192.168.1.0/24, 192.168.2.0/24, 192.168.3.0/24, 192.168.10.0/24, 192.168.40.0/24] via 192.168.4.2

[dns]
local barn.example.org
record nvr.barn.example.org: 192.168.4.10 (Barn.nvr)
forward cabin.example.org to 192.168.2.1 (Cabin)
forward home.example.org to 192.168.1.1 (Home)
public wg.cabin.example.org
