# Home: key ReplaceHomePublicKeyAAAAAAAAAAAAAAAAAAAAAAA=

[wireguard]
interface: listen 51820, address 10.100.0.1/16
peer Barn at 10.100.0.4: key ReplaceBarnPublicKeyAAAAAAAAAAAAAAAAAAAAAAA=, allowed [10.100.0.4/32, 192.168.4.0/24], routed, endpoint 203.0.113.30:51820, psk
peer Cabin at 10.100.0.2: key ReplaceCabinPublicKeyAAAAAAAAAAAAAAAAAAAAAA=, allowed [10.100.0.2/32, 192.168.2.0/24], routed, endpoint cabin.example.net:51820, psk
peer Lake at 10.100.0.3: key ReplaceLakePublicKeyAAAAAAAAAAAAAAAAAAAAAAA=, allowed [10.100.0.3/32, 192.168.3.0/24], routed, psk
peer Phone at 10.100.0.100: key ReplacePhonePublicKeyAAAAAAAAAAAAAAAAAAAAAA=, allowed [10.100.0.100/32], psk
peer Home.lte-cam at 10.100.10.10: key ReplaceLteCamPublicKeyAAAAAAAAAAAAAAAAAAAAA=, allowed [10.100.10.10/32]

[firewall]
mesh zone: input drop, output accept, forward drop
ping 10.100.0.1 from [Barn 10.100.0.4, Cabin 10.100.0.2, Lake 10.100.0.3, Phone 10.100.0.100, Home.lte-cam 10.100.10.10]
listen port: wan udp/51820
accept in Home ssh: tcp/22 from mesh [10.100.0.100/32] to the node [10.100.0.1/32, 192.168.10.1/32, 192.168.1.1/32]
accept in Home.tv cast: tcp/8009 from lan [192.168.1.0/24] to iot [192.168.10.20/32]
accept in Home.nas https: tcp/443 from mesh [10.100.0.100/32] to lan [192.168.1.20/32]
accept in Home.printer print: tcp/9100 from mesh [10.100.0.100/32] to lan [192.168.1.16/32]
accept in Home.lte-cam rtsp: tcp/554 from mesh [10.100.0.100/32] to mesh [10.100.10.10/32]
accept in Home.lte-cam rtsp: tcp/554 from lan [192.168.1.50/32] to mesh [10.100.10.10/32]
accept out Cabin.camera rtsp: tcp/554 from lan [192.168.1.50/32] to mesh [192.168.2.30/32]
otherwise drop: between [mesh, iot, lan], and from mesh to any zone
forward Home.nas https: wan tcp/8443 from [198.51.100.0/24] to lan 192.168.1.20:443

[dhcp]
lease Home.tv: 192.168.10.20 for [aa:bb:cc:00:00:05]
lease Home.nas: 192.168.1.20 for [aa:bb:cc:00:00:03]
lease Home.printer: 192.168.1.16 for [aa:bb:cc:00:00:02]
lease Phone: 192.168.1.50 for [aa:bb:cc:00:00:01]
